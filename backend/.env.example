# Copy this file to .env and fill in real values.
# Never commit the real .env file to version control.

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=banking_system
DB_USER=change_me
DB_PASS=change_me
DB_CHARSET=utf8mb4

# Set to "production" to enable stricter cookie/session security
APP_ENV=local

# Gmail SMTP, used to email OTP codes for sensitive actions (password
# change, disabling 2FA, confirming an email change). Free — no paid
# service needed.
#   1. Turn on 2-Step Verification on this Gmail account.
#   2. Google Account -> Security -> App Passwords -> generate one for
#      "Mail" / this app, and paste the 16-character result below.
#   3. Never use the account's real Gmail login password here.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change_me@gmail.com
MAIL_APP_PASSWORD=change_me
MAIL_FROM_NAME=Dot Bank
